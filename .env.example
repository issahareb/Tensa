PORT=3000
DATA_DIR=/data
PUBLIC_URL=
ADMIN_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=
SHOP_OPERATOR=
CONTACT_EMAIL=

# Sales remain disabled until all final product/operator settings are supplied.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=
SHIPPING_COUNTRIES=DE
# Seed once only; later stock adjustments belong in the inventory database.
SHOP_STOCK_JSON=
SHOP_SHIPPING_TEXT=
SHOP_RETURNS_TEXT=
SHOP_SIZE_GUIDE=

# Test is the default. Live additionally requires explicit confirmation of sales details.
PAYMENTS_MODE=test
SALES_DETAILS_CONFIRMED=false
# Enable in Stripe Dashboard first; supported allowlist: card,paypal,klarna.
STRIPE_PAYMENT_METHODS=card

# Apple Pay independently of Stripe, processed through PayPal (JS SDK v6).
APPLE_PAY_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
APPLE_PAY_DOMAIN_VERIFIED=false
# Absolute path to the matching PayPal sandbox/live domain association file.
APPLE_PAY_DOMAIN_ASSOCIATION_FILE=
# Exact EUR shipping amount for Apple Pay and manual orders. Empty disables those paths.
SHIPPING_AMOUNT_CENTS=

# Separate merchant-managed orders. Off until terms and real bank details are confirmed.
BANK_TRANSFER_ENABLED=false
INVOICE_ENABLED=false
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_TRANSFER_TERMS=
INVOICE_TERMS=
# Fixture/manual test orders only, visibly marked test mode. Never use real bank details here.
MANUAL_TEST_ENABLED=false
